{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 320,
  "padding": {"left": 5, "top": 5, "right": 5, "bottom": 5},
  "title": {"text": "How big each state is, and how its students split by sector, 2025",
            "subtitle": ["Column width = state's share of all Australian students. Numbers = % of the state's students in each sector", "Tas, ACT and NT are too narrow, so arrows point to their numbers on the right"]},
  "config": {"view": {"stroke": null}},
  "data": {"url": "data/sector_share_by_state_year.csv",
           "format": {"type": "csv", "parse": {"year": "number", "students": "number", "share_pct": "number"}}},
  "transform": [
    {"filter": "datum.year === 2025"},
    {"calculate": "indexof(['Government', 'Catholic', 'Independent'], datum.sector)", "as": "s_order"},
    {"joinaggregate": [{"op": "sum", "field": "students", "as": "state_total"}], "groupby": ["state_abbr"]},
    {"stack": "students", "groupby": ["state_abbr"], "sort": [{"field": "s_order"}],
     "offset": "normalize", "as": ["y0", "y1"]},
    {"calculate": "datum.s_order === 0 ? datum.state_total : 0", "as": "w"},
    {"stack": "w", "groupby": [], "offset": "normalize",
     "sort": [{"field": "state_total", "order": "descending"}, {"field": "s_order", "order": "ascending"}],
     "as": ["xa", "xb"]},
    {"joinaggregate": [{"op": "min", "field": "xa", "as": "x0"}, {"op": "max", "field": "xb", "as": "x1"}],
     "groupby": ["state_abbr"]},
    {"calculate": "(datum.x0 + datum.x1) / 2", "as": "x_mid"},
    {"calculate": "datum.x1 - datum.x0", "as": "state_pct"},
    {"calculate": "(datum.y0 + datum.y1) / 2", "as": "y_mid"}
  ],
  "layer": [
    {
      "mark": {"type": "rect", "stroke": "#ffffff", "strokeWidth": 1.5},
      "encoding": {
        "x": {"field": "x0", "type": "quantitative", "title": "Share of all Australian students (bar width)",
              "axis": {"format": "%", "values": [0, 0.25, 0.5, 0.75, 1]}, "scale": {"domain": [0, 1]}},
        "x2": {"field": "x1"},
        "y": {"field": "y0", "type": "quantitative", "title": "Share of the state's students",
              "axis": {"format": "%", "values": [0, 0.25, 0.5, 0.75, 1]}, "scale": {"domain": [0, 1]}},
        "y2": {"field": "y1"},
        "color": {"field": "sector", "type": "nominal", "title": null,
                  "scale": {"domain": ["Government", "Catholic", "Independent"],
                            "range": ["#1a47c4", "#d42a7f", "#0899c0"]},
                  "legend": {"orient": "top"}},
        "tooltip": [{"field": "state", "title": "State"}, {"field": "sector"},
                    {"field": "students", "type": "quantitative", "format": ","},
                    {"field": "share_pct", "type": "quantitative", "title": "Share of state (%)", "format": ".1f"},
                    {"field": "state_pct", "type": "quantitative", "title": "State's share of Australia", "format": ".1%"}]
      }
    },
    {
      "transform": [{"filter": "datum.s_order === 0 && datum.state_pct > 0.035"}],
      "mark": {"type": "text", "baseline": "bottom", "dy": -4, "fontWeight": 600, "fontSize": 12},
      "encoding": {"x": {"field": "x_mid", "type": "quantitative"}, "y": {"datum": 1},
                   "text": {"field": "state_abbr"}}
    },
    {
      "transform": [
        {"filter": "datum.state_pct <= 0.035"},
        {"pivot": "sector", "value": "share_pct", "groupby": ["state_abbr", "x_mid"]},
        {"window": [{"op": "row_number", "as": "rank"}], "sort": [{"field": "x_mid"}]},
        {"calculate": "1.05 - 0.27 * datum.rank", "as": "call_y"}
      ],
      "layer": [
        {"mark": {"type": "rule", "color": "#161513", "strokeWidth": 1, "x2Offset": 6},
         "encoding": {"x": {"field": "x_mid", "type": "quantitative"}, "x2": {"datum": 1},
                      "y": {"field": "call_y", "type": "quantitative"}}},
        {"mark": {"type": "point", "shape": "triangle-left", "filled": true, "size": 40, "color": "#161513", "opacity": 1},
         "encoding": {"x": {"field": "x_mid", "type": "quantitative"}, "y": {"field": "call_y", "type": "quantitative"}}},
        {"mark": {"type": "text", "align": "left", "baseline": "middle", "dx": 10, "fontWeight": 600, "fontSize": 12, "color": "#161513"},
         "encoding": {"x": {"datum": 1}, "y": {"field": "call_y", "type": "quantitative"}, "text": {"field": "state_abbr"}}},
        {"mark": {"type": "text", "align": "left", "baseline": "middle", "dx": 44, "fontWeight": 600, "fontSize": 12, "color": "#1a47c4"},
         "encoding": {"x": {"datum": 1}, "y": {"field": "call_y", "type": "quantitative"},
                      "text": {"field": "Government", "type": "quantitative", "format": ".0f"}}},
        {"mark": {"type": "text", "align": "left", "baseline": "middle", "dx": 68, "fontWeight": 600, "fontSize": 12, "color": "#d42a7f"},
         "encoding": {"x": {"datum": 1}, "y": {"field": "call_y", "type": "quantitative"},
                      "text": {"field": "Catholic", "type": "quantitative", "format": ".0f"}}},
        {"mark": {"type": "text", "align": "left", "baseline": "middle", "dx": 92, "fontWeight": 600, "fontSize": 12, "color": "#0899c0"},
         "encoding": {"x": {"datum": 1}, "y": {"field": "call_y", "type": "quantitative"},
                      "text": {"field": "Independent", "type": "quantitative", "format": ".0f"}}}
      ]
    },
    {
      "transform": [{"filter": "datum.state_pct > 0.035"}],
      "mark": {"type": "text", "baseline": "middle", "fontWeight": 600, "fontSize": 12},
      "encoding": {"x": {"field": "x_mid", "type": "quantitative"},
                   "y": {"field": "y_mid", "type": "quantitative"},
                   "text": {"field": "share_pct", "type": "quantitative", "format": ".0f"},
                   "color": {"condition": {"test": "datum.sector === 'Independent'", "value": "#161513"}, "value": "#ffffff"}}
    }
  ]
}
