{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Share of students at Independent schools, by state",
    "subtitle": "Hover a state to highlight it in every year"
  },
  "data": {
    "url": "data/sector_share_by_state_year.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "share_pct": "number",
        "students": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.sector === 'Independent' && indexof([2006, 2010, 2015, 2020, 2025], datum.year) >= 0"
    },
    {
      "lookup": "state",
      "from": {
        "data": {
          "url": "data/geo/australia_states.topojson",
          "format": {
            "type": "topojson",
            "feature": "states"
          }
        },
        "key": "id"
      },
      "as": "geo"
    }
  ],
  "facet": {
    "column": {
      "field": "year",
      "type": "ordinal",
      "title": null,
      "header": {
        "labelFontSize": 13,
        "labelFontWeight": 600,
        "labelPadding": 4
      }
    }
  },
  "spacing": 8,
  "spec": {
    "width": 182,
    "height": 180,
    "projection": {
      "type": "conicEqualArea",
      "parallels": [
        -18,
        -36
      ],
      "rotate": [
        -134,
        0,
        0
      ]
    },
    "params": [
      {
        "name": "hl",
        "select": {
          "type": "point",
          "fields": [
            "state"
          ],
          "on": "pointerover",
          "clear": "pointerout"
        }
      }
    ],
    "mark": {
      "type": "geoshape"
    },
    "encoding": {
      "shape": {
        "field": "geo",
        "type": "geojson"
      },
      "color": {
        "field": "share_pct",
        "type": "quantitative",
        "title": "Students at Independent schools (%)",
        "scale": {
          "type": "threshold",
          "domain": [
            12,
            14,
            16,
            18
          ],
          "range": [
            "#e2f4fa",
            "#a6dcee",
            "#55bddd",
            "#0899c0",
            "#05607e"
          ]
        },
        "legend": {
          "orient": "top",
          "direction": "horizontal",
          "gradientLength": 260,
          "titleLimit": 0
        }
      },
      "stroke": {
        "condition": {
          "param": "hl",
          "empty": false,
          "value": "#0b0b0b"
        },
        "value": "#ffffff"
      },
      "strokeWidth": {
        "condition": {
          "param": "hl",
          "empty": false,
          "value": 2
        },
        "value": 0.8
      },
      "tooltip": [
        {
          "field": "state",
          "title": "State"
        },
        {
          "field": "year",
          "type": "ordinal",
          "title": "Year"
        },
        {
          "field": "share_pct",
          "type": "quantitative",
          "title": "Independent share (%)",
          "format": ".1f"
        },
        {
          "field": "students",
          "type": "quantitative",
          "title": "Independent students",
          "format": ","
        }
      ]
    }
  },
  "config": {
    "view": {
      "stroke": null
    }
  }
}
