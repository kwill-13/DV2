{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "School students by sector, 2006 to 2025",
    "subtitle": {"expr": "view === 'Number of students' ? 'Number of students enrolled' : 'Change in students since 2006 (%)'"}
  },
  "width": "container",
  "height": 340,
  "padding": {"left": 5, "top": 5, "right": 135, "bottom": 5},
  "config": {"view": {"stroke": null}},
  "data": {
    "url": "data/enrolments_national_by_sector.csv",
    "format": {"type": "csv", "parse": {"year": "number", "students": "number"}}
  },
  "params": [
    {
      "name": "view",
      "value": "Growth since 2006 (%)",
      "bind": {"input": "radio", "options": ["Growth since 2006 (%)", "Number of students"], "name": "Show: "}
    }
  ],
  "transform": [
    {"calculate": "datum.year === 2006 ? datum.students : null", "as": "base_tmp"},
    {"joinaggregate": [{"op": "max", "field": "base_tmp", "as": "base"}], "groupby": ["sector"]},
    {"calculate": "(datum.students / datum.base - 1) * 100", "as": "growth_pct"},
    {"calculate": "view === 'Number of students' ? datum.students : datum.growth_pct", "as": "value"},
    {
      "calculate": "view === 'Number of students' ? format(datum.students / 1e6, '.2f') + 'M' : (datum.growth_pct > 0 ? '+' : '') + format(datum.growth_pct, '.0f') + '%'",
      "as": "value_label"
    }
  ],
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "title": null,
      "scale": {"domain": [2006, 2025]},
      "axis": {"format": "d", "tickCount": 10, "grid": false}
    }
  },
  "layer": [
    {
      "mark": {"type": "line", "strokeWidth": 2.5, "interpolate": "monotone"},
      "encoding": {
        "y": {
          "field": "value",
          "type": "quantitative",
          "title": null,
          "axis": {
            "labelExpr": "view === 'Number of students' ? format(datum.value / 1e6, '.1f') + 'M' : (datum.value > 0 ? '+' : '') + datum.value + '%'"
          }
        },
        "color": {
          "field": "sector",
          "type": "nominal",
          "scale": {"domain": ["Government", "Catholic", "Independent"], "range": ["#2a78d6", "#eb6834", "#1baf7a"]},
          "legend": null
        }
      }
    },
    {
      "transform": [{"filter": {"param": "hover", "empty": false}}],
      "mark": {"type": "point", "filled": true, "size": 60, "stroke": "#ffffff", "strokeWidth": 1.5, "opacity": 1},
      "encoding": {
        "y": {"field": "value", "type": "quantitative"},
        "color": {"field": "sector", "type": "nominal", "legend": null}
      }
    },
    {
      "transform": [{"filter": "datum.year === 2025"}],
      "mark": {"type": "text", "align": "left", "dx": 8, "fontSize": 12, "fontWeight": 600},
      "encoding": {
        "y": {"field": "value", "type": "quantitative"},
        "color": {"field": "sector", "type": "nominal", "legend": null},
        "text": {"field": "value_label"}
      }
    },
    {
      "transform": [{"filter": "datum.year === 2025"}],
      "mark": {"type": "text", "align": "left", "dx": 52, "fontSize": 12},
      "encoding": {
        "y": {"field": "value", "type": "quantitative"},
        "color": {"field": "sector", "type": "nominal", "legend": null},
        "text": {"field": "sector"}
      }
    },
    {
      "transform": [{"pivot": "sector", "value": "students", "groupby": ["year"]}],
      "params": [
        {
          "name": "hover",
          "select": {"type": "point", "fields": ["year"], "nearest": true, "on": "pointerover", "clear": "pointerout"}
        }
      ],
      "mark": {"type": "rule", "color": "#52514e", "strokeWidth": 1},
      "encoding": {
        "opacity": {"condition": {"param": "hover", "empty": false, "value": 0.45}, "value": 0},
        "tooltip": [
          {"field": "year", "type": "ordinal", "title": "Year"},
          {"field": "Government", "type": "quantitative", "format": ","},
          {"field": "Catholic", "type": "quantitative", "format": ","},
          {"field": "Independent", "type": "quantitative", "format": ","}
        ]
      }
    },
    {
      "data": {
        "values": [
          {"year": 2025, "y": 7, "align": "right", "sector": "Government", "label": "Government enrolments\nlevel off after 2020"},
          {"year": 2007, "y": 54, "align": "left", "sector": "Independent", "label": "Independent schools grew\nfastest: +62% since 2006"}
        ]
      },
      "transform": [{"filter": "view !== 'Number of students'"}],
      "mark": {"type": "text", "align": {"expr": "datum.align"}, "fontSize": 12, "fontStyle": "italic", "lineBreak": "\n", "baseline": "top"},
      "encoding": {
        "x": {"field": "year", "type": "quantitative"},
        "y": {"field": "y", "type": "quantitative"},
        "color": {"field": "sector", "type": "nominal", "legend": null},
        "text": {"field": "label"}
      }
    }
  ]
}
